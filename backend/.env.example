# ============================================
# 环境变量示例 - 复制为 .env 后填入真实值
# ============================================

# ---------- 服务配置 ----------
APP_NAME=AI-Travel-Planner
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ---------- LLM 配置（主模型 OpenAI，备选千问）----------
# 主模型
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 备选模型（阿里 DashScope - 千问）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen-plus

# 多模型降级策略：primary -> fallback
LLM_STRATEGY=primary_fallback

# ---------- Embedding 配置 ----------
# 本地 Embedding 模型（HuggingFace 模型名）
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu   # cpu / cuda

# 或使用在线 Embedding API
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# HuggingFace 镜像（国内加速下载）
HF_ENDPOINT=https://hf-mirror.com

# ---------- 向量数据库 ----------
# 后端选择：qdrant / chroma（开发环境推荐 chroma）
VECTOR_DB_BACKEND=chroma
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=travel_knowledge

# ChromaDB 备选
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=travel_knowledge

# ---------- 高德地图 API ----------
AMAP_KEY=xxxxxxxxxxxxxxxxxxxxxxxx   # Web 服务 Key
AMAP_SECURITY_CODE=                 # 安全密钥（JS API 用）

# ---------- 数据库 SQLite ----------
SQLITE_URL=sqlite+aiosqlite:///./data/sqlite/app.db

# ---------- 安全 ----------
API_SECRET_KEY=your-secret-key-here
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./logs
