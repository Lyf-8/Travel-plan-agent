# ============================================
# 前端环境变量示例 - 复制为 .env 后填入真实值
# Vite 要求以 VITE_ 开头的变量才能暴露到前端
# ============================================

# 后端 API 地址（开发环境通过 Vite 代理，用相对路径）
VITE_API_BASE_URL=/api

# 高德地图 JS API Key (前端使用)
VITE_AMAP_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
VITE_AMAP_SECURITY_CODE=xxxxxxxxxxxxxxxxxxxxxxxx

# 应用标题
VITE_APP_TITLE=AI 旅行攻略生成系统
