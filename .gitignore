# ============================================
# .gitignore - AI 旅行攻略生成系统
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
pip-wheel-metadata/

# 虚拟环境
.venv/
venv/
env/
ENV/

# ---------- 依赖 & 构建 ----------
build/
dist/
*.egg

# ---------- 数据库 & 数据 ----------
*.sqlite
*.sqlite3
*.db
backend/data/sqlite/*.db
backend/data/chroma/
logs/

# ---------- 环境变量（密钥不入库，仅提交 .env.example） ----------
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ---------- 前端 (Node) ----------
node_modules/
frontend/node_modules/
frontend/dist/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ---------- IDE / 编辑器 ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- 测试 & 覆盖率 ----------
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---------- Jupyter ----------
.ipynb_checkpoints
